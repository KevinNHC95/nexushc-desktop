{
  "name": "nexushc-desktop",
  "version": "1.0.0",
  "description": "Coquille desktop NEXUS HC (Portail + navigation interne CRM/NOVA)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "fr.nexushc.desktop",
    "productName": "NEXUS HC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
